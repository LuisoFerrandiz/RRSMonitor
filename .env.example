# --- Paginas RRS (cambia solo RRS_EVENT_ID; usa {id_evento} en ambas URLs, no [id_evento] por compatibilidad con bash) ---
RRS_EVENT_ID=13476
RRS_URL=https://www.racingrulesofsailing.org/schedules/{id_evento}/event
RRS_DOCUMENTS_URL=https://www.racingrulesofsailing.org/documents/{id_evento}/event
# Hearing Decisions: texto → custom field "DECISION"; enlace "Full Decision" → casilla "Full Decision" + adjunto PDF
RRS_DECISIONS_URL=https://www.racingrulesofsailing.org/decisions/{id_evento}/event
POLL_INTERVAL_MS=60000
DATA_DIR=./data

# Telegram (opcional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trello — audiencias / scheduling
TRELLO_ENABLED=false
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
TRELLO_SCHEDULE_LIST_ID=
TRELLO_DECIDED_LIST_ID=

# Protest Time Limit(s) en la página RRS → lista Trello (ej. "Time Limit")
TRELLO_TIMELIMIT_LIST_ID=

# Event Documents → lista "TOA-Documents" (id de lista Trello)
TRELLO_TOA_DOCUMENTS_LIST_ID=
